# Actual Budget Server & HTTP API Bridge settings
ACTUAL_HTTP_API_URL=http://localhost:5007
ACTUAL_HTTP_API_KEY=my-secret-actual-api-key
ACTUAL_SYNC_ID=your-budget-sync-id-here

# Google Sheets Configuration
# Path to the Google Cloud Service Account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json

# The ID of your Google Spreadsheet (found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# Sheet / Tab name (e.g., "Sheet1" or "Transactions")
GOOGLE_SHEET_TAB_NAME=Sheet1

# Row range to read/update (Default starts at row 2 to skip headers: A2:H)
# Columns expected:
# A: Date (YYYY-MM-DD or readable date)
# B: Account (Name of account in Actual Budget, e.g. "Checking", "Credit Card")
# C: Payee (e.g. "Starbucks", "Amazon")
# D: Amount (positive or negative number, e.g. -25.50 or 25.50)
# E: Category (Name of category in Actual Budget, optional)
# F: Notes (Optional notes)
# G: Cleared ("true"/"false" or "yes"/"no", defaults to true)
# H: Status ("Synced" will be written here after successful import)
GOOGLE_SHEET_RANGE=Sheet1!A2:H
